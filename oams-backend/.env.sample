# ── Hanu Multimedia backend config ──────────────────────────────────────
# Copy this file to ".env" and fill in your MySQL details.
# When DB_HOST is set, the backend uses MySQL DIRECTLY (db.json is NOT used).
# The backend auto-creates the database + tables on first run — you don't
# have to create them manually.

PORT=4000

# ---- LOCAL MySQL (XAMPP) ----  (default XAMPP user is root with NO password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oams
DB_USER=root
DB_PASSWORD=

# ---- LIVE SERVER (VPS) ----  use your server's DB user/password instead:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=oams
# DB_USER=oamsuser
# DB_PASSWORD=your_strong_password
