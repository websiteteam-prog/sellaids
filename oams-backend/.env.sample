# ── Hanu Multimedia backend config ──────────────────────────────────────────────
# Copy this file to ".env" and fill in your VPS MySQL details.
# When DB_HOST is set, the backend uses MySQL. If you leave it empty/unset,
# it falls back to the local db.json file (handy for quick local testing).

PORT=4000

# MySQL (on your VPS). Create the DB + user first (see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oams
DB_USER=oamsuser
DB_PASSWORD=change_this_password
