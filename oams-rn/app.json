{
  "expo": {
    "name": "Hanu Multimedia",
    "slug": "oams-field-app",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.oams.fieldapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16294D"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withSplashColor",
      "./plugins/withAbiFilter",
      "./plugins/withCleartext",
      [
        "expo-image-picker",
        { "cameraPermission": "Allow Hanu Multimedia to take geo-tagged store photos." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Allow Hanu Multimedia to tag store photos with your GPS location." }
      ]
    ]
  }
}
